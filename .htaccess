Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Static assets (skip rewriting) ---
  RewriteRule ^(styles\.css|favicon\.ico|robots\.txt)$ - [L]
  RewriteRule ^(images|assets|uploads)/.*$ - [L]

  # --- Language homepages: /en/, /es/, /fr/ ---
  RewriteRule ^en/?$   en/index.php  [L]
  RewriteRule ^es/?$   es/index.php  [L]
  RewriteRule ^fr/?$   fr/index.php  [L]

  # --- English routes ---
  RewriteRule ^en/properties/?$      en/properties.php   [L]
  RewriteRule ^en/neighborhoods/?$   en/neighborhoods.php [L]
  RewriteRule ^en/investment-guide/?$ en/investment-guide.php [L]
  RewriteRule ^en/about/?$           en/about.php        [L]
  RewriteRule ^en/contact/?$         en/contact.php      [L]

  # --- Spanish routes ---
  RewriteRule ^es/propiedades/?$       es/properties.php   [L]
  RewriteRule ^es/barrios/?$           es/neighborhoods.php [L]
  RewriteRule ^es/guia-de-inversion/?$ es/investment-guide.php [L]
  RewriteRule ^es/nosotros/?$          es/about.php        [L]
  RewriteRule ^es/contacto/?$          es/contact.php      [L]

  # --- French routes ---
  RewriteRule ^fr/proprietes/?$           fr/properties.php   [L]
  RewriteRule ^fr/quartiers/?$            fr/neighborhoods.php [L]
  RewriteRule ^fr/guide-investissement/?$ fr/investment-guide.php [L]
  RewriteRule ^fr/a-propos/?$             fr/about.php        [L]
  RewriteRule ^fr/contact/?$              fr/contact.php      [L]

  # --- Legacy English URLs (301 redirect to /en/...) ---
  RewriteRule ^properties/?$      /en/properties      [R=301,L]
  RewriteRule ^neighborhoods/?$   /en/neighborhoods   [R=301,L]
  RewriteRule ^investment-guide/?$ /en/investment-guide [R=301,L]
  RewriteRule ^about/?$           /en/about           [R=301,L]
  RewriteRule ^contact/?$         /en/contact         [R=301,L]

  # --- Blog: handled by WordPress, not rewritten ---
  RewriteRule ^blog(/.*)?$  - [L]
</IfModule>

ErrorDocument 404 /404.php
